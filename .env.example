# ---------- Web ----------
NEXT_PUBLIC_SITE_URL=https://formotax.ecommica.com
NEXT_PUBLIC_API_URL=https://formotax.ecommica.com/api/v1

# ---------- API ----------
NODE_ENV=development
PORT=4000
WEB_URL=https://formotax.ecommica.com
DATABASE_URL="mysql://tax:tax_password@localhost:3306/tax_form"
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=2592000
CORS_ORIGINS=https://formotax.ecommica.com,http://localhost:3000
# Pay-per-download billing: filling is free, each PDF download costs
# DOWNLOAD_PRICE_USD and stays re-downloadable for DOWNLOAD_ACCESS_HOURS.
DOWNLOAD_PRICE_USD=1
DOWNLOAD_ACCESS_HOURS=24

# ---------- Admin / seeding ----------
ADMIN_EMAIL=admin@formotax.com
ADMIN_PASSWORD=ChangeMe123!

# ---------- Docker Compose ----------
# Public origin used by nginx and by NEXT_PUBLIC_API_URL in the web image.
# Keep it in sync with HTTP_PORT (include the port when it is not 80).
PUBLIC_BASE_URL=https://formotax.ecommica.com
HTTP_PORT=127.0.0.1:8080
MYSQL_DATABASE=tax_form
MYSQL_USER=tax
MYSQL_PASSWORD=tax_password
MYSQL_ROOT_PASSWORD=root_password
MYSQL_PORT=3306
REDIS_PORT=6379

# Official PDF templates and writable local storage (no object storage needed).
# TEMPLATE_DIR holds the copies shipped with the app; files under
# STORAGE_DIR/templates override them without a rebuild.
TEMPLATE_DIR=../web/public/templates
STORAGE_DIR=./storage

# Payments: PayPal only. Checkout refuses new orders while the credentials are empty.
# PayPal REST app credentials (developer.paypal.com → Apps & Credentials)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id for /api/v1/payments/webhook/paypal (verify-webhook-signature)
PAYPAL_WEBHOOK_ID=
PAYPAL_BRAND_NAME="FormoTax"
# Optional override, e.g. a proxy in front of api-m.sandbox.paypal.com
PAYPAL_API_URL=

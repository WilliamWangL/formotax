# Next.js web app image. Build context: repository root.
FROM node:22-alpine AS build

RUN apk add --no-cache libc6-compat \
  && npm install -g pnpm@12.8.1

WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

# Workspace manifests first so dependency layers cache well.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps

RUN pnpm install --frozen-lockfile
RUN pnpm --filter './packages/**' build

ARG NEXT_PUBLIC_SITE_URL=http://localhost
ARG NEXT_PUBLIC_API_URL=http://localhost/api/v1
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

RUN pnpm --filter @tax/web build

FROM node:22-alpine AS runtime

RUN apk add --no-cache libc6-compat \
  && npm install -g pnpm@12.8.1

WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000

COPY --from=build /app ./

EXPOSE 3000
CMD ["pnpm", "--filter", "@tax/web", "start"]

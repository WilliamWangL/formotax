# NestJS API image. Build context: repository root.
FROM node:22-alpine AS build

RUN apk add --no-cache libc6-compat openssl \
  && npm install -g pnpm@12.8.1

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps

RUN pnpm install --frozen-lockfile
RUN pnpm --filter './packages/**' build
RUN pnpm --filter @tax/api prisma:generate
RUN pnpm --filter @tax/api build

FROM node:22-alpine AS runtime

RUN apk add --no-cache libc6-compat openssl \
  && npm install -g pnpm@12.8.1

WORKDIR /app
ENV NODE_ENV=production

COPY --from=build /app ./

WORKDIR /app/apps/api
EXPOSE 4000

# Migrations are applied before the server starts; the seed is idempotent and
# can be run separately with `pnpm prisma:seed`.
CMD ["sh", "-c", "pnpm prisma:deploy && node dist/main.js"]
